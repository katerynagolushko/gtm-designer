# SQLite locally; swap to a Postgres URL in production (see README)
DATABASE_URL="file:./dev.db"

# Server-side only — never exposed to the client
ANTHROPIC_API_KEY=""
# Optional override; defaults to claude-opus-5
ANTHROPIC_MODEL=""

# Absolute base URL used in magic-link emails
APP_URL="http://localhost:3000"

# The single admin user. Sign in with this email to see /admin.
ADMIN_EMAIL="katerinagolushko@gmail.com"

# Optional: if set, magic links are emailed via Resend.
# If unset (local dev), the magic link is printed to the server console.
RESEND_API_KEY=""
EMAIL_FROM="GTM Sprint <login@momentummill.com>"
