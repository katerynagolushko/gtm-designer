# SQLite locally. Do not copy this value into Vercel — a file: URL is read-only
# there and hides a Supabase/Neon database. On Vercel, leave DATABASE_URL unset
# (the Supabase integration supplies POSTGRES_PRISMA_URL / POSTGRES_URL /
# POSTGRES_URL_NON_POOLING) or set DATABASE_URL to a postgres:// URL.
DATABASE_URL="file:./dev.db"

# Server-side only — never exposed to the client. Not NEXT_PUBLIC_.
ANTHROPIC_API_KEY=""
# Optional override; defaults to claude-opus-5 (active model id). Leave blank
# unless the key's workspace cannot call that model.
ANTHROPIC_MODEL=""

# Absolute base URL written into magic-link emails.
# Local dev only. On Vercel set the public https origin, e.g.
# https://your-project.vercel.app — a localhost value is ignored there.
APP_URL="http://localhost:3001"

# Who can open /admin. This is not a sign-in allowlist; any email can sign in.
ADMIN_EMAIL="katerinagolushko@gmail.com"

# Required in production. If unset locally, the magic link is printed to the
# server console instead of emailed. EMAIL_FROM must be a sender Resend will
# accept: onboarding@resend.dev (delivers only to the Resend account owner)
# or an address on a domain verified in the Resend dashboard.
RESEND_API_KEY=""
EMAIL_FROM="GTM Sprint <login@momentummill.com>"
